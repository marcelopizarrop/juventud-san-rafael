# Copia este archivo como ".env.local" para probar el formulario de contacto
# en tu computador. En producción, estas variables se configuran en
# Vercel: Settings -> Environment Variables (ver README, sección 6).

# API key gratuita de https://resend.com (Dashboard -> API Keys)
RESEND_API_KEY=

# Correo donde quieres recibir los mensajes del formulario de contacto.
# Opcional: si lo dejas vacío, los mensajes llegan a informaciones.jcu@gmail.com
CONTACTO_EMAIL=
